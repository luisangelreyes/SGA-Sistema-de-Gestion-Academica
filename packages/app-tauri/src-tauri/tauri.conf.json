{
  "$schema": "https://schema.tauri.app/2.0.0/schema.json",
  "productName": "SGA",
  "version": "1.0.0",
  "identifier": "com.sga.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend-v2",
    "beforeBuildCommand": "npm run build --workspace=frontend-v2",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../frontend-v2/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SGA",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
